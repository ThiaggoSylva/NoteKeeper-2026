{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/*.{css,js,ico,svg,png,jpg,jpeg,webp,woff,woff2,map,txt,json}"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
